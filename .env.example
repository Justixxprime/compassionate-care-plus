# Compassionate Care Plus - example environment file
#
# HOW TO USE THIS FILE
# 1. Copy it and name the copy ".env.local"
# 2. Fill in real values in ".env.local"
# 3. Never commit ".env.local" - it is ignored by git on purpose
#
# Every variable is documented in docs/ENVIRONMENT_VARIABLES.md

# The public address of the app. Safe for the browser.
NEXT_PUBLIC_APP_URL="https://compassionate-care-plus.vercel.app/"

# Turns on synthetic demo data and the "Demonstration data" banner.
# This stays "true" for the whole development period.
NEXT_PUBLIC_DEMO_MODE="true"

# --- Database (added this phase) ---
# The connection string for the local PostgreSQL database. SECRET -
# never goes to the browser, never gets committed with a real value.
# Format: postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME
# See docs/DATABASE.md for exactly how to get this value.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cheliv_dev"

# --- Added in later phases, listed here so I know what is coming ---
# AUTH_SECRET=             # Phase: authentication. SECRET.
# EMAIL_SERVER_HOST=       # Phase: notifications. Local mail catcher in development.

# --- Round G1: Request care ---
# Where a submitted "Request care" form is meant to reach. NOT a live
# mailbox yet - no e-mail service is wired up (see docs/CARE_REQUESTS.md).
# Safe to leave unset; falls back to the placeholder address in
# src/lib/care-request-constants.ts. Not secret.
CARE_REQUEST_NOTIFY_EMAIL="justixxchiobi@gmail.com"

# --- Cloudflare R2 demo document storage ---
# Keep these only in .env.local. Never paste or commit the real values.
# R2 is permitted for synthetic demo documents only; do not enable it for
# real patient documents without the approved production compliance path.
R2_ACCOUNT_ID="YOUR_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="cheliv-demo-documents"

# A long random secret used only by the future internal malware-scanner
# callback. Do not set it until a real scanner is configured.
DOCUMENT_SCANNER_TOKEN="GENERATE_A_LONG_RANDOM_SECRET"
