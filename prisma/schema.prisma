// prisma/schema.prisma
//
// This is the database's blueprint. Every model below becomes a real
// table once I run a migration. I am deliberately starting with ONLY the
// identity and access tables - organizations, users, roles, permissions,
// sessions - not the full clinical schema from PHASE_0_ARCHITECTURE.md
// section 7 yet. Patients, visits, care plans and the rest come in
// Milestone D, once authentication actually works end to end. Building
// the whole schema now would mean testing none of it for weeks.
//
// IMPORTANT LIMITATION I RAN INTO WHILE BUILDING THIS: I cannot run any
// Prisma commands (generate, migrate, studio) from the sandbox I build
// in - Prisma needs to download an engine binary from
// binaries.prisma.sh, and that domain isn't reachable from where I work.
// That means I wrote this file by hand rather than having Prisma
// generate or validate it for me, and the actual first migration has to
// run on your machine - which is normal anyway, since only your machine
// can see your local PostgreSQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Organization ----------
// Every sensitive resource eventually hangs off an organization, even
// though there is only one organization (Cheliv Compassionate Care Plus)
// today. See PHASE_0_ARCHITECTURE.md section 68 - this is what keeps one
// organization's data from ever leaking into another's, if this system
// is ever used by more than one organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  roles    Role[]
  patients  Patient[]
  visits    Visit[]
  carePlans CarePlan[]

  @@map("organizations")
}

// ---------- Users ----------
// One row per person who can sign in - staff and, later, patients and
// family members alike. passwordHash is never the plain password - see
// src/server/auth/README.md once that exists for how hashing works.
model User {
  id            String    @id @default(uuid())
  organizationId String   @map("organization_id")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  sessions     Session[]
  careTeamMemberships CareTeamMember[]
  assignedVisits      Visit[]          @relation("VisitClinician")
  scheduledVisits     Visit[]          @relation("VisitScheduler")
  authoredCarePlans   CarePlan[]       @relation("CarePlanAuthor")
  approvedCarePlans   CarePlan[]       @relation("CarePlanApprover")

  @@index([organizationId])
  @@map("users")
}

// ---------- Sessions ----------
// A signed-in session, stored in the database rather than only in a
// cookie. This is what lets a user see "active sessions" and revoke one
// remotely (PHASE_0_ARCHITECTURE.md section 9), and what lets me
// invalidate every session for a user immediately if an account is
// compromised - a JWT-only session can't be revoked early the same way.
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------- Roles & permissions ----------
// Roles are scoped to an organization (so "ADMIN" at one organization
// never accidentally matches "ADMIN" at another, once there is more than
// one organization). Permissions are global strings like
// "patients.read" - see PHASE_0_ARCHITECTURE.md section 8 for the full
// list this will grow into.
model Role {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  key            String // e.g. "ADMIN", "NURSE", "CAREGIVER"
  name           String // human readable, e.g. "Administrator"

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique // e.g. "patients.read"

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Join table: which permissions a role holds.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Join table: which roles a user holds.
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------- Audit log ----------
// A record of who did what, when, and whether it was allowed - see
// PHASE_0_ARCHITECTURE.md section 56. Deliberately does NOT log the
// content of what was viewed or changed, only the fact that the action
// happened - "clinical record viewed" gets logged, the clinical
// record's actual content never does.
//
// actorUserId is nullable because a failed sign-in attempt (wrong
// email/password) has no real user to attach to - logging failed
// attempts against the email that was TRIED, not a real account, is
// itself useful security signal (repeated failures against one email is
// what a lockout policy would watch for later).
model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  actorEmail   String?  @map("actor_email") // set on failed sign-in, where there is no real user row yet
  action       String // e.g. "sign_in", "sign_in_failed", "sign_out", "permission_denied"
  resourceType String?  @map("resource_type") // e.g. "session", "permission"
  resourceId   String?  @map("resource_id")
  outcome      String // "allowed" | "denied"
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([actorUserId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ---------- Patients & care team ----------
// The first slice of Milestone D's clinical schema - deliberately just
// this much, not the full model from PHASE_0_ARCHITECTURE.md section 7
// yet. Visits, care plans, referrals and documents all hang off a
// patient, so patients come first.
//
// synthetic data ONLY - see PHASE_0_ARCHITECTURE.md's opening rules.
// Every patient this seed script creates is clearly fictional.
model Patient {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  dateOfBirth    DateTime @map("date_of_birth")
  status         String   @default("active") // active | discharged | on_hold
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  careTeam      CareTeamMember[]
  visits        Visit[]
  carePlans     CarePlan[]

  @@index([organizationId])
  @@map("patients")
}

// This join table is the actual mechanism behind "relationship-based
// access" from PHASE_0_ARCHITECTURE.md section 3: a nurse can only see
// patients they're actually assigned to, not every patient in the
// organization. Administrative roles (ADMIN, SUPER_ADMIN,
// CLINICAL_SUPERVISOR, CARE_COORDINATOR) bypass this and see every
// patient - that check lives in src/lib/patients.ts, not here; this
// table just records the real assignments.
model CareTeamMember {
  id         String    @id @default(uuid())
  patientId  String    @map("patient_id")
  userId     String    @map("user_id")
  roleOnCase String    @map("role_on_case") // e.g. "primary_nurse", "caregiver"
  startsAt   DateTime  @default(now()) @map("starts_at")
  endsAt     DateTime? @map("ends_at") // null = still active on this case

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([userId])
  @@map("care_team_members")
}

// ---------- Visits ----------
// The second slice of Milestone D. A visit is one scheduled home visit:
// which patient, which clinician, what kind of visit, when, and where it
// stands (scheduled -> in_progress -> completed, or cancelled / missed).
//
// Deliberately NO clinical content here - no notes, vitals or
// documentation. Those are separate, more sensitive tables that come
// later (PHASE_0_ARCHITECTURE.md section 7: visit_notes, clinical_notes).
// A visit row only says that a visit is happening, never what was found.
//
// Who may see or change a visit is decided in src/lib/visits.ts, using
// the same two-part rule as patients: a role permission (visits.read,
// visits.create, visits.update) AND a relationship to the patient.
//
// organizationId is carried on the row even though there is one
// organization today - PHASE_0_ARCHITECTURE.md section 7, every
// tenant-scoped table carries it.
//
// Visits are never hard-deleted. Cancelling changes status and stays on
// record, because "this visit was cancelled, by whom, and when" is
// something a real organization may need to answer later.
model Visit {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String    @map("patient_id")
  clinicianId    String    @map("clinician_id") // the staff member doing the visit
  scheduledById  String    @map("scheduled_by_id") // who put it on the calendar
  visitType      String    @map("visit_type") // e.g. "skilled_nursing" - list lives in src/lib/visit-constants.ts
  status         String    @default("scheduled") // scheduled | in_progress | completed | cancelled | missed
  scheduledStart DateTime  @map("scheduled_start")
  scheduledEnd   DateTime  @map("scheduled_end")
  checkedInAt    DateTime? @map("checked_in_at")
  checkedOutAt   DateTime? @map("checked_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinician    User         @relation("VisitClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  scheduledBy  User         @relation("VisitScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)

  @@index([organizationId, scheduledStart])
  @@index([patientId])
  @@index([clinicianId])
  @@map("visits")
}

// ---------- Care plans ----------
// The third slice of Milestone D. A care plan says what the care team is
// trying to achieve for one patient, as a short summary plus a list of
// goals. It is the first table here that holds real clinical CONTENT
// (the words a clinician wrote), so its access rules are stricter than
// visits.
//
// Who may see, write and approve a plan is decided in
// src/lib/care-plans.ts. Three questions are asked, not two:
//
//   1. PERMISSION   care_plans.read / .create / .update / .approve
//   2. RELATIONSHIP the patient must be one this person can reach
//                   (getPatientScope in src/lib/patients.ts)
//   3. TEAM         WRITING clinical content additionally requires being
//                   on that patient's care team right now. An
//                   administrator can read every plan and approve them,
//                   but does not write clinical content for patients they
//                   are not on the care team of.
//
// A plan goes draft -> active (approved by someone OTHER than the author)
// -> completed. A draft can be discarded (archived). Once a plan is
// active its wording is locked: what was approved cannot be quietly
// changed. Plans are never hard-deleted.
//
// Deliberately NOT here yet: versions/revision history, diagnoses,
// interventions, signatures. Those come with the clinical record.
model CarePlan {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String    @map("patient_id")
  authorId       String    @map("author_id") // who wrote the draft
  approvedById   String?   @map("approved_by_id") // who made it active
  title          String
  summary        String
  status         String    @default("draft") // draft | active | completed | archived
  approvedAt     DateTime? @map("approved_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author       User          @relation("CarePlanAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approvedBy   User?         @relation("CarePlanApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  goals        CarePlanGoal[]

  @@index([organizationId, status])
  @@index([patientId])
  @@map("care_plans")
}

// One goal inside a plan. Goals are added while the plan is a draft and
// can be removed then; once the plan is active they are locked, except
// that a goal can be marked met as the patient makes progress.
model CarePlanGoal {
  id          String    @id @default(uuid())
  carePlanId  String    @map("care_plan_id")
  description String
  status      String    @default("open") // open | met
  position    Int       @default(0)
  metAt       DateTime? @map("met_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@index([carePlanId])
  @@map("care_plan_goals")
}
