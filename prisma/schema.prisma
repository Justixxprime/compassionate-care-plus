// prisma/schema.prisma
//
// This is the database's blueprint. Every model below becomes a real
// table once I run a migration. I am deliberately starting with ONLY the
// identity and access tables - organizations, users, roles, permissions,
// sessions - not the full clinical schema from PHASE_0_ARCHITECTURE.md
// section 7 yet. Patients, visits, care plans and the rest come in
// Milestone D, once authentication actually works end to end. Building
// the whole schema now would mean testing none of it for weeks.
//
// IMPORTANT LIMITATION I RAN INTO WHILE BUILDING THIS: I cannot run any
// Prisma commands (generate, migrate, studio) from the sandbox I build
// in - Prisma needs to download an engine binary from
// binaries.prisma.sh, and that domain isn't reachable from where I work.
// That means I wrote this file by hand rather than having Prisma
// generate or validate it for me, and the actual first migration has to
// run on your machine - which is normal anyway, since only your machine
// can see your local PostgreSQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Organization ----------
// Every sensitive resource eventually hangs off an organization, even
// though there is only one organization (Cheliv Compassionate Care Plus)
// today. See PHASE_0_ARCHITECTURE.md section 68 - this is what keeps one
// organization's data from ever leaking into another's, if this system
// is ever used by more than one organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  roles    Role[]
  patients  Patient[]
  visits    Visit[]
  visitNotes VisitNote[]
  visitNoteAddenda VisitNoteAddendum[]
  notifications Notification[]
  tasks Task[]
  carePlans CarePlan[]
  documents Document[]
  referrals Referral[]
  documentAccessGrants DocumentAccessGrant[]
  auditLogs AuditLog[]

  @@map("organizations")
}

// ---------- Users ----------
// One row per person who can sign in - staff and, later, patients and
// family members alike. passwordHash is never the plain password - see
// src/server/auth/README.md once that exists for how hashing works.
model User {
  id            String    @id @default(uuid())
  organizationId String   @map("organization_id")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  sessions     Session[]
  careTeamMemberships CareTeamMember[]
  assignedVisits      Visit[]          @relation("VisitClinician")
  scheduledVisits     Visit[]          @relation("VisitScheduler")
  assignedTasks       Task[]           @relation("TaskAssignee")
  createdTasks        Task[]           @relation("TaskCreator")
  completedTasks      Task[]           @relation("TaskCompleter")
  authoredVisitNotes  VisitNote[]      @relation("VisitNoteAuthor")
  reviewedVisitNotes  VisitNote[]      @relation("VisitNoteReviewer")
  authoredAddenda     VisitNoteAddendum[] @relation("AddendumAuthor")
  reviewedAddenda     VisitNoteAddendum[] @relation("AddendumReviewer")
  notifications       Notification[]
  authoredCarePlans   CarePlan[]       @relation("CarePlanAuthor")
  approvedCarePlans   CarePlan[]       @relation("CarePlanApprover")
  uploadedDocuments   Document[]       @relation("DocumentUploader")
  archivedDocuments   Document[]       @relation("DocumentArchiver")
  createdReferrals    Referral[]       @relation("ReferralCreator")
  decidedReferrals    Referral[]       @relation("ReferralDecider")
  receivedDocumentGrants DocumentAccessGrant[] @relation("GrantGrantee")
  givenDocumentGrants    DocumentAccessGrant[] @relation("GrantGiver")
  revokedDocumentGrants  DocumentAccessGrant[] @relation("GrantRevoker")

  @@index([organizationId])
  @@map("users")
}

// ---------- Sessions ----------
// A signed-in session, stored in the database rather than only in a
// cookie. This is what lets a user see "active sessions" and revoke one
// remotely (PHASE_0_ARCHITECTURE.md section 9), and what lets me
// invalidate every session for a user immediately if an account is
// compromised - a JWT-only session can't be revoked early the same way.
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------- Roles & permissions ----------
// Roles are scoped to an organization (so "ADMIN" at one organization
// never accidentally matches "ADMIN" at another, once there is more than
// one organization). Permissions are global strings like
// "patients.read" - see PHASE_0_ARCHITECTURE.md section 8 for the full
// list this will grow into.
model Role {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  key            String // e.g. "ADMIN", "NURSE", "CAREGIVER"
  name           String // human readable, e.g. "Administrator"

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique // e.g. "patients.read"

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Join table: which permissions a role holds.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Join table: which roles a user holds.
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------- Audit log ----------
// A record of who did what, when, and whether it was allowed - see
// PHASE_0_ARCHITECTURE.md section 56. Deliberately does NOT log the
// content of what was viewed or changed, only the fact that the action
// happened - "clinical record viewed" gets logged, the clinical
// record's actual content never does.
//
// actorUserId is nullable because a failed sign-in attempt (wrong
// email/password) has no real user to attach to - logging failed
// attempts against the email that was TRIED, not a real account, is
// itself useful security signal (repeated failures against one email is
// what a lockout policy would watch for later).
model AuditLog {
  id             String   @id @default(uuid())
  // Nullable on purpose: a failed sign-in against an email that matches
  // no user belongs to no organization yet, and old rows written before
  // this column existed have no value to backfill it from. Every entry
  // written going forward carries the actor's organization, and the
  // audit log page only ever shows one organization's own rows.
  organizationId String?  @map("organization_id")
  actorUserId  String?  @map("actor_user_id")
  actorEmail   String?  @map("actor_email") // set on failed sign-in, where there is no real user row yet
  action       String // e.g. "sign_in", "sign_in_failed", "sign_out", "permission_denied"
  resourceType String?  @map("resource_type") // e.g. "session", "permission"
  resourceId   String?  @map("resource_id")
  outcome      String // "allowed" | "denied"
  occurredAt   DateTime @default(now()) @map("occurred_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([actorUserId])
  @@index([occurredAt])
  @@index([organizationId, occurredAt])
  @@map("audit_logs")
}

// ---------- Patients & care team ----------
// The first slice of Milestone D's clinical schema - deliberately just
// this much, not the full model from PHASE_0_ARCHITECTURE.md section 7
// yet. Visits, care plans, referrals and documents all hang off a
// patient, so patients come first.
//
// synthetic data ONLY - see PHASE_0_ARCHITECTURE.md's opening rules.
// Every patient this seed script creates is clearly fictional.
model Patient {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  dateOfBirth    DateTime @map("date_of_birth")
  status         String   @default("active") // active | discharged | on_hold
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  careTeam      CareTeamMember[]
  visits        Visit[]
  tasks         Task[]
  carePlans     CarePlan[]
  documents     Document[]
  referrals     Referral[]
  documentAccessGrants DocumentAccessGrant[]

  @@index([organizationId])
  @@map("patients")
}

// This join table is the actual mechanism behind "relationship-based
// access" from PHASE_0_ARCHITECTURE.md section 3: a nurse can only see
// patients they're actually assigned to, not every patient in the
// organization. Administrative roles (ADMIN, SUPER_ADMIN,
// CLINICAL_SUPERVISOR, CARE_COORDINATOR) bypass this and see every
// patient - that check lives in src/lib/patients.ts, not here; this
// table just records the real assignments.
model CareTeamMember {
  id         String    @id @default(uuid())
  patientId  String    @map("patient_id")
  userId     String    @map("user_id")
  roleOnCase String    @map("role_on_case") // e.g. "primary_nurse", "caregiver"
  startsAt   DateTime  @default(now()) @map("starts_at")
  endsAt     DateTime? @map("ends_at") // null = still active on this case

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([userId])
  @@map("care_team_members")
}

// ---------- Visits ----------
// The second slice of Milestone D. A visit is one scheduled home visit:
// which patient, which clinician, what kind of visit, when, and where it
// stands (scheduled -> in_progress -> completed, or cancelled / missed).
//
// Deliberately NO clinical content here - no notes, vitals or
// documentation. Those are separate, more sensitive tables that come
// later (PHASE_0_ARCHITECTURE.md section 7: visit_notes, clinical_notes).
// A visit row only says that a visit is happening, never what was found.
//
// Who may see or change a visit is decided in src/lib/visits.ts, using
// the same two-part rule as patients: a role permission (visits.read,
// visits.create, visits.update) AND a relationship to the patient.
//
// organizationId is carried on the row even though there is one
// organization today - PHASE_0_ARCHITECTURE.md section 7, every
// tenant-scoped table carries it.
//
// Visits are never hard-deleted. Cancelling changes status and stays on
// record, because "this visit was cancelled, by whom, and when" is
// something a real organization may need to answer later.
model Visit {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String    @map("patient_id")
  clinicianId    String    @map("clinician_id") // the staff member doing the visit
  scheduledById  String    @map("scheduled_by_id") // who put it on the calendar
  visitType      String    @map("visit_type") // e.g. "skilled_nursing" - list lives in src/lib/visit-constants.ts
  status         String    @default("scheduled") // scheduled | in_progress | completed | cancelled | missed
  scheduledStart DateTime  @map("scheduled_start")
  scheduledEnd   DateTime  @map("scheduled_end")
  checkedInAt    DateTime? @map("checked_in_at")
  checkedOutAt   DateTime? @map("checked_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinician    User         @relation("VisitClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  scheduledBy  User         @relation("VisitScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)
  visitNote    VisitNote?

  @@index([organizationId, scheduledStart])
  @@index([patientId])
  @@index([clinicianId])
  @@map("visits")
}

// ---------- Visit notes ----------
// The first piece of real clinical CONTENT written about a specific
// visit - what the clinician actually found and did, as opposed to the
// Visit row above, which only ever says a visit is happening. This is
// the "visit_notes" table PHASE_0_ARCHITECTURE.md section 7 held back
// for later - later is now, at the start of the clinical portal (E3).
//
// One note per visit, written only by that visit's assigned clinician,
// only once the visit has actually started (in_progress or completed -
// documenting something that has not happened yet makes no sense). Who
// may read, write and review it is decided in src/lib/visit-notes.ts,
// using the same three-question shape as care plans:
//
//   1. PERMISSION   visits.document to write, visits.review to review
//                   (requirePermission, a hard stop)
//   2. RELATIONSHIP is this visit's patient one this person can reach?
//                   (getPatientScope, the same code visits itself uses)
//   3. AUTHOR       WRITING is further restricted to the visit's own
//                   assigned clinician - not just anyone on the care
//                   team, because this note is a first-person record of
//                   what THEY did at THIS visit.
//
// draft -> submitted -> reviewed. A draft can be edited by its author.
// Once submitted the wording is locked, the same way an active care plan
// is locked - a correction after that point is a new event, not a quiet
// edit. Four eyes on review, exactly like care plan approval: the person
// who wrote the note can never be the one who reviews it.
//
// Never hard-deleted, and the content itself is never written to the
// audit log - only that a note was created, submitted or reviewed, the
// same "what happened, never what it said" rule every other clinical
// table here follows.
model VisitNote {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  visitId        String    @unique @map("visit_id")
  authorId       String    @map("author_id")
  reviewedById   String?   @map("reviewed_by_id")
  content        String
  status         String    @default("draft") // draft | submitted | reviewed
  submittedAt    DateTime? @map("submitted_at")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Restrict)
  author       User         @relation("VisitNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("VisitNoteReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  addenda      VisitNoteAddendum[]

  @@index([organizationId])
  @@map("visit_notes")
}

// ---------- Visit note addenda ----------
// A reviewed note is final and is never edited. When it turns out to need
// correcting or completing, the visit's own clinician adds an ADDENDUM: a
// separate, permanent entry that sits under the note. The original words
// are never touched. An addendum is written once (no editing, no
// deleting) and then waits for a second person, exactly like a note.
//
// Rules live in src/lib/visit-notes.ts. Never hard-deleted (Restrict).
model VisitNoteAddendum {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  noteId         String    @map("note_id")
  authorId       String    @map("author_id")
  reviewedById   String?   @map("reviewed_by_id")
  kind           String    // correction | additional_information | late_entry
  content        String
  status         String    @default("submitted") // submitted | reviewed
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  note         VisitNote    @relation(fields: [noteId], references: [id], onDelete: Restrict)
  author       User         @relation("AddendumAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("AddendumReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([noteId])
  @@index([organizationId, status])
  @@map("visit_note_addenda")
}

// ---------- Notifications ----------
// A short "something happened for you" entry. It holds NO words about
// patients or clinical content: only what kind of thing happened and
// which record it points at. The screen turns the kind into a plain,
// generic sentence and a link, and the page behind the link checks access
// again. One row belongs to exactly one person.
//
// Rules live in src/lib/notifications.ts.
model Notification {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  kind           String
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------- Care plans ----------
// The third slice of Milestone D. A care plan says what the care team is
// trying to achieve for one patient, as a short summary plus a list of
// goals. It is the first table here that holds real clinical CONTENT
// (the words a clinician wrote), so its access rules are stricter than
// visits.
//
// Who may see, write and approve a plan is decided in
// src/lib/care-plans.ts. Three questions are asked, not two:
//
//   1. PERMISSION   care_plans.read / .create / .update / .approve
//   2. RELATIONSHIP the patient must be one this person can reach
//                   (getPatientScope in src/lib/patients.ts)
//   3. TEAM         WRITING clinical content additionally requires being
//                   on that patient's care team right now. An
//                   administrator can read every plan and approve them,
//                   but does not write clinical content for patients they
//                   are not on the care team of.
//
// A plan goes draft -> active (approved by someone OTHER than the author)
// -> completed. A draft can be discarded (archived). Once a plan is
// active its wording is locked: what was approved cannot be quietly
// changed. Plans are never hard-deleted.
//
// Deliberately NOT here yet: versions/revision history, diagnoses,
// interventions, signatures. Those come with the clinical record.
model CarePlan {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String    @map("patient_id")
  authorId       String    @map("author_id") // who wrote the draft
  approvedById   String?   @map("approved_by_id") // who made it active
  title          String
  summary        String
  status         String    @default("draft") // draft | active | completed | archived
  approvedAt     DateTime? @map("approved_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author       User          @relation("CarePlanAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approvedBy   User?         @relation("CarePlanApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  goals        CarePlanGoal[]

  @@index([organizationId, status])
  @@index([patientId])
  @@map("care_plans")
}

// One goal inside a plan. Goals are added while the plan is a draft and
// can be removed then; once the plan is active they are locked, except
// that a goal can be marked met as the patient makes progress.
model CarePlanGoal {
  id          String    @id @default(uuid())
  carePlanId  String    @map("care_plan_id")
  description String
  status      String    @default("open") // open | met
  position    Int       @default(0)
  metAt       DateTime? @map("met_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@index([carePlanId])
  @@map("care_plan_goals")
}

// ---------- Documents ----------
// The fourth slice of Milestone D. A document is one file filed against
// one patient: a signed consent, a physician order, an insurance card, a
// scan of an ID. Files are the most sensitive thing this system holds
// after the clinical record itself, so this table asks a question the
// earlier slices did not: not only WHICH PATIENT, but WHAT KIND of
// document.
//
// Who may see, file and archive a document is decided in
// src/lib/documents.ts:
//
//   1. PERMISSION   documents.read / .upload / .delete
//   2. RELATIONSHIP the patient must be one this person can reach
//                   (getPatientScope in src/lib/patients.ts)
//   3. CATEGORY     insurance and identification documents are
//                   RESTRICTED: only administrative roles can see them.
//                   A nurse on the care team sees the clinical paperwork
//                   (consents, orders, correspondence) but never the
//                   scan of the patient's ID or insurance card, and a
//                   restricted document does not even appear to exist to
//                   them.
//
// The file's bytes live in their own table (document_files) so that no
// list or search of documents can ever pull file contents into memory by
// accident; a query has to ask for the bytes on purpose.
//
// For this demo the bytes are stored in the database, which is free and
// keeps everything testable on one machine. A real deployment should
// move them to encrypted object storage with short-lived download
// links. That is a paid-service decision and is deliberately NOT made
// here; everything outside src/lib/documents.ts is unaware of where the
// bytes live, so the swap changes one file. See docs/DOCUMENTS.md.
//
// Documents are never hard-deleted. "Archive" hides one from every list
// and download and keeps the row and bytes on record.
//
// The audit log records that a document was uploaded, DOWNLOADED and
// archived - the first place in this project where reading is logged -
// never what the document said.
model Document {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String    @map("patient_id")
  uploadedById   String    @map("uploaded_by_id")
  category       String // list and restricted flags live in src/lib/document-constants.ts
  title          String
  fileName       String    @map("file_name")
  contentType    String    @map("content_type") // decided by reading the file's own bytes, never by what the browser claimed
  sizeBytes      Int       @map("size_bytes")
  sha256         String // fingerprint of the bytes: integrity, and stops the same file being filed twice
  status         String    @default("active") // active | archived
  archivedAt     DateTime? @map("archived_at")
  archivedById   String?   @map("archived_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedBy   User          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  archivedBy   User?         @relation("DocumentArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  file         DocumentFile?
  accessGrants DocumentAccessGrant[]

  @@index([organizationId, status])
  @@index([patientId])
  @@index([patientId, sha256])
  @@map("documents")
}

// ---------- Sharing restricted documents ----------
// Insurance cards and ID scans are RESTRICTED. By default only the two
// administrator roles (SUPER_ADMIN and ADMIN) can see them. A grant is how
// an administrator lets ONE other person look, on purpose, for as long as
// they choose:
//   - patientId only (documentId empty): every restricted document of that
//     patient, including ones filed later
//   - patientId and documentId: that single document
// A grant is only ever permission to LOOK and download. It never lets
// anyone file, archive or share a document, and it never widens which
// patients a person can reach: they must already reach the patient, and
// the normal permission (documents.read) still applies.
//
// A grant is never deleted. Taking one back sets revokedAt, and access ends
// at once. An expired grant (expiresAt in the past) counts as ended. The
// audit log records that a grant was made or taken back, never what the
// document said. See docs/DOCUMENTS.md.
model DocumentAccessGrant {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String    @map("patient_id")
  documentId     String?   @map("document_id")
  granteeId      String    @map("grantee_id")
  grantedById    String    @map("granted_by_id")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedById    String?   @map("revoked_by_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  grantee      User         @relation("GrantGrantee", fields: [granteeId], references: [id], onDelete: Restrict)
  grantedBy    User         @relation("GrantGiver", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("GrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([granteeId, revokedAt])
  @@index([patientId])
  @@index([organizationId])
  @@map("document_access_grants")
}

// The bytes of one document. One row per document, deleted with it.
model DocumentFile {
  documentId String @id @map("document_id")
  data       Bytes

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_files")
}

// ---------- Referrals ----------
// A referral is a request for the organization to take on someone's
// care: a hospital discharge planner, a physician's office, a family
// member or the person themselves asks. It usually arrives BEFORE the
// person is a patient, which is the difference from every other model
// in this file: patientId is empty until the referral is accepted, and
// an unlinked referral has no care team to check. See
// docs/REFERRALS.md for the access rules.
//
// Three layers of visibility, all decided in src/lib/referrals.ts:
//   1. Summary (who, source, service, urgency, status): anyone who may
//      see the referral at all.
//   2. Clinical reason: the same people. A nurse on the care team of the
//      linked patient legitimately needs it.
//   3. Office details (outside contact, office notes, decision note):
//      administrative roles only. Everyone else's query never selects
//      these columns.
// An unlinked referral is visible to administrative roles only, because
// the person is not a patient yet and nobody has a relationship to them.
//
// Referrals are never hard-deleted. Accepted, declined and withdrawn
// are final states.
model Referral {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  patientId          String?   @map("patient_id") // set only when the referral is accepted
  createdById        String    @map("created_by_id")
  decidedById        String?   @map("decided_by_id")
  decidedAt          DateTime? @map("decided_at")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  dateOfBirth        DateTime  @map("date_of_birth")
  sourceType         String    @map("source_type") // hospital | physician_office | family | self | other
  sourceOrganization String?   @map("source_organization")
  sourceContactName  String?   @map("source_contact_name") // office details
  sourceContactPhone String?   @map("source_contact_phone") // office details
  requestedService   String    @map("requested_service") // a visit type key from src/lib/visit-constants.ts
  urgency            String    @default("routine") // routine | urgent
  reason             String // clinical: why care is being requested
  officeNotes        String?   @map("office_notes") // office details
  decisionNote       String?   @map("decision_note") // office details: why it was declined or withdrawn
  status             String    @default("received") // received | in_review | accepted | declined | withdrawn
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ReferralCreator", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("ReferralDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([patientId])
  @@map("referrals")
}

// ---------- Tasks ----------
// A small piece of work somebody owes: "call the pharmacy about
// Eleanor's refill", "collect the signed consent form". Optionally about
// one patient, always with one person responsible (the assignee) and one
// person who asked for it (the creator).
//
// Who may see, create and close a task is decided in src/lib/tasks.ts:
//   1. PERMISSION   tasks.read to see and finish tasks, tasks.manage to
//                   create and cancel them (requirePermission).
//   2. RELATIONSHIP a task about a patient is only visible to someone who
//                   can still reach that patient (getPatientScope).
//   3. OWNERSHIP    administrative roles see every task in the
//                   organization; everyone else sees only tasks assigned
//                   to them or created by them.
//
// open -> done or open -> cancelled, and both are final. Never hard
// deleted. The audit log records that a task was created or closed,
// never its title or details, because a title can name a patient's need.
model Task {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  patientId      String?   @map("patient_id")
  assigneeId     String    @map("assignee_id")
  createdById    String    @map("created_by_id")
  completedById  String?   @map("completed_by_id")
  title          String
  details        String?
  dueDate        DateTime? @map("due_date") // a calendar day, stored as midnight UTC
  status         String    @default("open") // open | done | cancelled
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy  User?        @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([patientId])
  @@map("tasks")
}
