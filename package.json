  "verify:tasks": "tsx --tsconfig tsconfig.scripts.json scripts/verify-tasks.ts"
},
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
